# Copy to .env. Values below are a disposable 1.21.9 development baseline.
# Review Creative ZIP before selecting production versions. Never use latest.
STACK_ID=vampyuyu-local
PUID=1000
PGID=1000
DOCKER_GID=131
STATE_DIR=./state
SECRETS_DIR=./secrets
ARCHIVES_DIR=./archives
# Minecraft servers refuse startup until you explicitly accept the EULA.
EULA=FALSE
MC_VERSION=1.21.9
PAPER_BUILD=59
VELOCITY_VERSION=3.4.0-SNAPSHOT
VELOCITY_BUILD=563
MC_IMAGE=itzg/minecraft-server:java21@sha256:9f87a7fd070a117584f57cd134bfd9448d4070d9ec1bf45fd3b083737211ab2b
PROXY_IMAGE=itzg/bungeecord:java21@sha256:991beba3f17f9fbeb9b885c25ce13c4e4e4fc5741ef87cc64d3495dcb9ab886f
LOBBY_MEMORY=1G
CREATIVE_MEMORY=6G
SURVIVAL_MEMORY=6G
LOBBY_LIMIT=2g
CREATIVE_LIMIT=8g
SURVIVAL_LIMIT=8g
MAX_PLAYERS=40
VIEW_DISTANCE=8
SIMULATION_DISTANCE=6
MC_BIND=127.0.0.1
# Shown in the TAB footer; production should use play.vampyuyu.win.
MC_CONNECT_ADDRESS=localhost:25565
# Production: change STACK_ID, MC_BIND=0.0.0.0 and PUBLIC_ORIGIN below.
PUBLIC_ORIGIN=http://localhost:5173
NETWORK_CURRENCY_NAME=Shards
IMAGE_REPOSITORY=ghcr.io/garder500/minecraft-bungee
# Required immutable Git commit SHA when using production Compose.
IMAGE_TAG=replace-with-published-40-character-commit-sha
TLS_DIR=./secrets/tls
# Optional menu resource pack: base URL players download /pack/<sha1>.zip from.
# Defaults to PUBLIC_ORIGIN in production and http://localhost:8080 locally.
# MENU_PACK_BASE_URL=
